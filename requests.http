@host = http://localhost:3000
@apiKey = replace-with-the-key-printed-by-the-seed

### non streaming, local provider, no api key needed
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "What is the capital of France?" }
  ]
}

### same request again, served from the exact cache
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "What is the capital of France?" }
  ]
}

### rewritten prompt, same meaning, served from the semantic cache
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "Which city is the capital of France?" }
  ]
}

### the same question in Portuguese, a separate cache entry on purpose
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "Qual é a capital da França?" }
  ]
}

### rewritten Portuguese prompt, served from the semantic cache
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "Que cidade é a capital da França?" }
  ]
}

### streaming
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "Name three colours" }
  ],
  "stream": true
}

### temperature above zero bypasses the cache, the caller asked for variation
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [
    { "role": "user", "content": "Give me a random colour." }
  ],
  "temperature": 0.9
}

### openai, only routable when OPENAI_API_KEY is set
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "gpt-4o-mini",
  "messages": [
    { "role": "user", "content": "What is the capital of France?" }
  ]
}

### anthropic, only routable when ANTHROPIC_API_KEY is set
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "claude-haiku-4-5",
  "messages": [
    { "role": "user", "content": "What is the capital of France?" }
  ],
  "stream": true
}

### unsupported model, expects 400
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "llama-3-70b",
  "messages": [{ "role": "user", "content": "hello" }]
}

### empty messages, expects 400
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": []
}

### invalid role, expects 400
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "local-small",
  "messages": [{ "role": "root", "content": "hello" }]
}

### missing model, expects 400
POST {{host}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "messages": [{ "role": "user", "content": "hello" }]
}

### no Authorization header, expects 401
POST {{host}}/v1/chat/completions
Content-Type: application/json

{
  "model": "local-small",
  "messages": [{ "role": "user", "content": "hello" }]
}
